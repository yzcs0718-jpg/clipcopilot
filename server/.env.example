# 零费用模式：保持为 0，后端不会发送模型请求。
ALLOW_MODEL_CALLS=0
APP_TOKEN=generate-a-random-long-token
ALLOWED_ORIGIN=https://clippilot-video-workbench.jayden-97.chatgpt.site
HOST=127.0.0.1
PORT=8787

# 四家接入预设（均可留空，本地功能不需要 API）
DEFAULT_PROVIDER=zhipu
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-5.3
ZHIPU_VISION_MODEL=glm-4.6v
KIMI_API_KEY=
KIMI_MODEL=kimi-k3.1-pro
KIMI_VISION_MODEL=kimi-k3.1-pro
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_VISION_MODEL=deepseek-flash
DOUBAO_API_KEY=
# 豆包按火山方舟控制台填写 Model ID 或 ep- 接入点 ID
DOUBAO_MODEL=
DOUBAO_VISION_MODEL=

# 可选覆盖默认官方地址；Kimi 国际区可设置相应的官方域名
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 保留旧的自定义兼容接口（可全部留空）
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
VISION_MODEL_NAME=
